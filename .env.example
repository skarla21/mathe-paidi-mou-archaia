# Supabase (NUXT_ prefix for runtimeConfig)
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NUXT_SUPABASE_SERVICE_KEY=your-service-role-key

# Stripe
NUXT_STRIPE_SECRET_KEY=sk_test_...
NUXT_STRIPE_WEBHOOK_SECRET=whsec_...

# Auth (Auth.js)
NUXT_AUTH_SECRET=your-random-secret
NUXT_GOOGLE_CLIENT_ID=your-google-client-id
NUXT_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Resend (contact form, verification, password reset emails)
NUXT_RESEND_API_KEY=re_xxxxxxxxxxxx
NUXT_CONTACT_EMAIL=your-email@example.com

# reCAPTCHA v2 checkbox (contact form). Site key is public; secret stays server-only.
# Also set both in the Vercel project environment for Production.
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
NUXT_RECAPTCHA_SECRET_KEY=